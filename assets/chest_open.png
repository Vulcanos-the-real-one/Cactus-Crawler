<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="128" height="128" shape-rendering="crispEdges">
  <!-- Offener Deckel (nach hinten geklappt) -->
  <rect x="12" y="8" width="40" height="12" fill="#5C2E0B" />
  <rect x="14" y="10" width="36" height="8" fill="#8B4513" />
  <rect x="12" y="8" width="40" height="2" fill="#DAA520" />

  <!-- Truhen-Unterteil -->
  <rect x="12" y="28" width="40" height="24" fill="#8B4513" />
  <rect x="14" y="30" width="36" height="20" fill="#A0522D" />
  <rect x="12" y="48" width="40" height="4" fill="#DAA520" />

  <!-- Gold-Inhalt / Funkeln -->
  <rect x="16" y="22" width="32" height="8" fill="#FFD700" />
  <rect x="20" y="20" width="8" height="4" fill="#FFA500" />
  <rect x="36" y="20" width="8" height="4" fill="#FFA500" />
  <rect x="28" y="18" width="4" height="4" fill="#FFFFFF" />
</svg>
