<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="128" height="128" shape-rendering="crispEdges">
  <!-- Körper / Basis-Stein -->
  <rect x="16" y="20" width="32" height="28" fill="#5a5e6b" />
  <rect x="20" y="16" width="24" height="4" fill="#5a5e6b" />
  <rect x="12" y="24" width="4" height="20" fill="#5a5e6b" />
  <rect x="48" y="24" width="4" height="20" fill="#5a5e6b" />

  <!-- Highlights / Helle Steinkanten -->
  <rect x="20" y="16" width="24" height="2" fill="#7a7e8c" />
  <rect x="16" y="20" width="4" height="24" fill="#7a7e8c" />
  <rect x="20" y="20" width="8" height="4" fill="#7a7e8c" />

  <!-- Schatten / Dunkle Steinkanten -->
  <rect x="16" y="46" width="32" height="2" fill="#3a3d45" />
  <rect x="44" y="20" width="4" height="28" fill="#3a3d45" />

  <!-- Faust Links -->
  <rect x="4" y="28" width="8" height="16" fill="#484b54" />
  <rect x="4" y="28" width="8" height="2" fill="#7a7e8c" />
  <rect x="4" y="42" width="8" height="2" fill="#2d2f36" />

  <!-- Faust Rechts -->
  <rect x="52" y="28" width="8" height="16" fill="#484b54" />
  <rect x="52" y="28" width="8" height="2" fill="#7a7e8c" />
  <rect x="52" y="42" width="8" height="2" fill="#2d2f36" />

  <!-- Beine / Füße -->
  <rect x="20" y="48" width="8" height="8" fill="#3a3d45" />
  <rect x="36" y="48" width="8" height="8" fill="#3a3d45" />

  <!-- GLÜHENDE AUGEN (Magischer Kern) -->
  <rect x="22" y="26" width="6" height="4" fill="#00ffff" />
  <rect x="36" y="26" width="6" height="4" fill="#00ffff" />
  <rect x="24" y="27" width="2" height="2" fill="#ffffff" />
  <rect x="38" y="27" width="2" height="2" fill="#ffffff" />

  <!-- Risse im Stein (Magie-Adern) -->
  <rect x="30" y="32" width="4" height="2" fill="#00ffff" opacity="0.8" />
  <rect x="32" y="34" width="2" height="6" fill="#00ffff" opacity="0.8" />
  <rect x="26" y="38" width="8" height="2" fill="#00ffff" opacity="0.8" />
</svg>
